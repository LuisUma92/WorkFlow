%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%  eval-UCIMED.sty
%  ---------------------------------------------------------------------------
%  Comandos de EVALUACIÓN (ítems, puntaje, solucionario) para documentos UCIMED.
%
%  Extracto AUTOSUFICIENTE de SetCommands.sty + PartialCommands.sty: sólo lo que
%  se usa al escribir una prueba. Los archivos de ítem del banco de ejercicios
%  compilan sin cambios con este paquete.
%
%  Requiere:  format-UCIMED.sty  (banderas test/solutions/main y utilidades)
%             comands-UCIMED.sty (\setgroup, \setclass, \thecycle)
%
%  ---------------------------------------------------------------------------
%  MAPA DE USO
%
%   Estructura de un ítem  (un archivo .tex por ítem):
%     \question{<enunciado>}{<solución>}
%       · DOS argumentos obligatorios. El `}{` que los separa es estructural:
%         si se borra, enunciado y solución se funden y la solución desaparece.
%       · Sub-partes: dentro del PRIMER argumento, en un enumerate[a)], cada
%         una con \qpart{<enunciado>}{<solución>}; el segundo argumento queda {}.
%       · \qpart YA emite su propio \paragraph{Solución:} — no escribirlo a mano.
%
%   Puntaje  (vive embebido en el archivo del ítem):
%     \pts[add]{n}   n puntos, sumados al contador de la sección
%     \upt[add]      1 punto,  sumado al contador de la sección
%     \pts{n}        n puntos, SÓLO se imprime (no suma) — para rúbricas
%     \ptscu{n}      «(n pts c/u.)»      \uptcu  «(1 pt c/u.)»
%     \ptsdistro     abre el bloque «Distribución de puntos» de una rúbrica
%     \consolidatePoints{<etiqueta>}
%                    cierra una sección: vuelca el subtotal a <etiqueta>, lo
%                    suma al total del examen y pone el contador en cero.
%                    Se recupera con \ref*{<etiqueta>} en el texto de la sección.
%
%   Selección única / complete:
%     \rightoption      marca ✓ azul la opción correcta (sólo si solutions=true)
%     \completeline{x}  imprime la línea en blanco, o la respuesta si solutions
%
%   Encabezado de la prueba:
%     \setpartialnumber{n}   n=0 → título tal cual; n>0 → «Título I/II/III…»
%     \testdefinition{<grupo>}{<ciclo>}{<n>}   atajo de los tres a la vez
%     \AANlines               tres líneas para apellidos y nombre
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{eval-UCIMED}[2026/08/13 v1.0 Comandos de evaluacion UCIMED]

\RequirePackage{format-UCIMED}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%  1) Contadores de puntaje
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\newcounter{partialNumber}
\newcounter{totalPoints}
\newcounter{sectionPoints}
\newcounter{points}

% El encabezado `partial` imprime \total{totalPoints}. totcount exige que el
% contador esté registrado ANTES de usarse; se registra aquí, una sola vez, para
% que \tableofcontents no dispare «\c@totalPoints@totc undefined».
\regtotcounter{totalPoints}
\regtotcounter{sectionPoints}

\newcommand{\thepartial}{}
\newcommand{\setpartialnumber}[1]{%
  \setcounter{partialNumber}{#1}%
  \setcounter{totalPoints}{0}%
  \setcounter{sectionPoints}{0}%
  \setcounter{points}{0}%
  \ifthenelse{#1 = 0}{%
    \renewcommand{\thepartial}{\thetitle}%
  }{%
    \renewcommand{\thepartial}{\thetitle\:\Roman{partialNumber}}%
  }%
}
\newcommand{\testdefinition}[3]{%
  \setgroup{#1}%
  \setcycle{#2}%
  \setpartialnumber{#3}%
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%  2) Puntaje por ítem
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\newcommand{\ptsdistro}{%
  \paragraph{Distribución de puntos}
  \ifthenelse{\boolean{test}}{%
    \renewcommand{\labelenumiii}{\theenumi\theenumii-\arabic{enumiii})}%
  }{%
    \renewcommand{\labelenumii}{\arabic{example}\alph{enumi}-\arabic{enumii})}%
  }%
}
\newcommand{\pts}[2][]{%
  (\textit{#2 pts.})%
  \ifthenelse{\equal{#1}{add}}{\addtocounter{points}{#2}}{}%
}
\newcommand{\upt}[1][]{%
  (\textit{1 pt.})%
  \ifthenelse{\equal{#1}{add}}{\addtocounter{points}{1}}{}%
}
\newcommand{\uptcu}{(\textit{1 pt c/u.})}
\newcommand{\ptscu}[1]{(\textit{#1 pts c/u.})}
\newcommand{\consolidatePoints}[1]{%
  \setcounter{sectionPoints}{\value{points}}%
  \addtocounter{totalPoints}{\value{points}}%
  \setcounter{points}{0}%
  \protected@write\@auxout{}{%
    \string\newlabel{#1}{{\arabic{sectionPoints}}{\thepage}}%
  }%
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%  3) Ítems
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% #1 = enunciado   #2 = solución  (los DOS son obligatorios)
\newcommand{\question}[2]{%
  \ifthenelse{\boolean{test}}{%
    \item
    \addcontentsline{toc}{subsection}{Pregunta \theenumi}
    #1
    \ifthenelse{\boolean{solutions}}{#2}{}%
  }{%
    #1\par
    \ifthenelse{\boolean{solutions}}{#2}{}%
  }%
}
% Sub-parte. Va DENTRO de un enumerate, en el PRIMER argumento de \question.
% Emite su propio «Solución:» — no duplicarlo.
\newcommand{\qpart}[2]{%
  \item
  #1
  \ifthenelse{\boolean{solutions}}{%
    \paragraph{Solución:}
    #2
  }{}%
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%  4) Selección única y complete
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\newcommand{\rightoption}{%
  \ifthenelse{\boolean{solutions}}{{\color{blue}\ding{51}}}{}%
}
\newcommand{\inputline}{\line(1,0){150}}
\newcommand{\completeline}[1]{%
  \ifthenelse{\boolean{solutions}}{\textbf{\color{blue}#1}\;}{\inputline\;}%
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%  5) Numeración y sangrías de las secciones de desarrollo
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\newcommand{\partialenumi}{\renewcommand{\labelenumi}{\arabic{enumi}.}}
\newcommand{\setthisindent}{}   % sin sangría extra en UCIMED

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%  6) Referencia bibliográfica del ítem (\exa) — sólo si main=true
%     \exa[<capítulo>]{<número>}  imprime «cap.núm.» con la numeración del libro
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\newcounter{lastChapter}
\newcounter{example}[section]
\newcommand{\exa}[2][]{%
  \par
  \ifblank{#2}{\stepcounter{example}}{\setcounter{example}{#2}}%
  \ifblank{#1}{%
    \arabic{section}.\arabic{example}.%
  }{%
    \setcounter{lastChapter}{\value{section}}%
    \setcounter{section}{#1}%
    \arabic{section}.\arabic{example}.%
    \setcounter{section}{\thelastChapter}%
  }%
  \hspace{0.5em}\ignorespaces
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%  7) Encabezado de identificación del estudiante
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\newcommand{\AANlines}{%
\begin{minipage}{0.3\textwidth}
  \begin{center}
    \line(1,0){139}

    \textbf{Primer apellido}
  \end{center}
\end{minipage}
\hfill
\begin{minipage}{0.3\textwidth}
  \begin{center}
    \line(1,0){139}

    \textbf{Segundo apellido}
  \end{center}
\end{minipage}
\hfill
\begin{minipage}{0.3\textwidth}
  \begin{center}
    \line(1,0){139}

    \textbf{Nombre completo}
  \end{center}
\end{minipage}
\vspace*{0.5cm}

}

%==< Versiones de una misma prueba >===========================================
% Un solo documento contiene N versiones del examen. El número de versión se
% lleva en \setgroup, igual que en CI0006 (en registro hay un solo grupo).
%
%   \setversion{01}          en el preámbulo: versión que se imprime cuando
%                            solutions=false
%   \ifversion{01}{ ... }    en el cuerpo: bloque de esa versión
%
%   solutions=false → imprime SÓLO la versión fijada con \setversion.
%   solutions=true  → imprime TODAS las versiones seguidas, con solucionario,
%                     y cada bloque rotula su encabezado con su propio grupo.
%
% \laversion guarda la versión elegida y es lo único que se compara, así que
% \ifversion puede reasignar \setgroup para rotular sin romper los bloques
% siguientes.
\newcommand{\laversion}{01}
\newcommand{\setversion}[1]{\renewcommand{\laversion}{#1}\setgroup{#1}}

\newcommand{\ifversion}[2]{%
  \ifthenelse{\boolean{solutions} \OR \equal{\laversion}{#1}}{%
    \setgroup{#1}%
    \ifthenelse{\boolean{solutions}}{%
      \newpage\phantomsection
      \addcontentsline{toc}{section}{\thegroup}%
      \begin{center}
        \large{\textbf{\thegroup}}\hfill\large{\thecycle}
      \end{center}
    }{}%
    #2%
  }{}%
}

%==< Hoja de respuestas >======================================================
% \hojaRespuestas[<opciones por ítem de selección única; def. 5>]
%                {<n.º de ítems de Complete>}
%                {<n.º de ítems de Selección única>}
%                {<n.º de ítems de Respuesta corta>}
%
% Complete y Selección única quedan lado a lado, en dos columnas. La Respuesta
% corta va debajo, en una tabla del ancho de la página que se parte entre
% páginas si hace falta. Pasar 0 en cualquiera de los tres omite ese bloque.
%
% NOTA: bajo babel-spanish los caracteres < y > son shorthands ACTIVOS, así que
% aquí no se usa ninguna comparación con ellos. Los bucles avanzan hasta la
% igualdad (\unless\ifnum ... = ...), que sólo necesita el signo «=».
\newcounter{hojaresp@i}
\newcounter{hojaresp@j}

% Renglón en blanco numerado (Complete).
\newcommand{\hojaResp@lineas}[1]{%
  \setcounter{hojaresp@i}{0}%
  \loop\unless\ifnum\value{hojaresp@i}=#1\relax
    \stepcounter{hojaresp@i}%
    \noindent\makebox[1.8em][r]{\thehojaresp@i.}\,%
    \rule[-0.6ex]{\dimexpr\linewidth-2.4em\relax}{0.4pt}\par
    \vspace{2.4ex}%
  \repeat}

% Fila de casillas a–e (Selección única).
\newcommand{\hojaResp@opciones}[2]{%
  \setcounter{hojaresp@i}{0}%
  \loop\unless\ifnum\value{hojaresp@i}=#1\relax
    \stepcounter{hojaresp@i}%
    \noindent\makebox[1.8em][r]{\thehojaresp@i.}\,%
    {\setcounter{hojaresp@j}{0}%
     \loop\unless\ifnum\value{hojaresp@j}=#2\relax
       \stepcounter{hojaresp@j}%
       \framebox[1.7em]{\rule[-0.5ex]{0pt}{2.4ex}\small\alph{hojaresp@j}}%
       \hspace{0.25em}%
     \repeat}%
    \par\vspace{2.4ex}%
  \repeat}

% Cuerpo de la tabla de respuesta corta: se arma primero como lista de tokens y
% se vuelca de una sola vez, porque un \loop dentro de longtable interfiere con
% el escaneo de la alineación.
\newcommand{\hojaResp@fila}[1]{%
  \multicolumn{1}{|c|}{#1} & & & \tabularnewline[2.6ex]\hline}

\newcommand{\hojaResp@tabla}[1]{%
  \def\hojaResp@cuerpo{}%
  \setcounter{hojaresp@i}{0}%
  \loop\unless\ifnum\value{hojaresp@i}=#1\relax
    \stepcounter{hojaresp@i}%
    \edef\hojaResp@tmp{\noexpand\hojaResp@fila{\thehojaresp@i}}%
    \expandafter\g@addto@macro\expandafter\hojaResp@cuerpo
      \expandafter{\hojaResp@tmp}%
  \repeat
  \begingroup
    \setlength{\tabcolsep}{4pt}%
    \renewcommand{\arraystretch}{1.2}%
    % xltabular: las tres columnas X se reparten el ancho sobrante, así la
    % tabla ocupa siempre el ancho completo de la página.
    \begin{xltabular}{\textwidth}{|c|X|X|X|}
      \hline
      \textbf{\#} & \textbf{Fórmula} & \textbf{Datos empleados}
        & \textbf{Resultado numérico}\tabularnewline
      \hline
      \endfirsthead
      \hline
      \textbf{\#} & \textbf{Fórmula} & \textbf{Datos empleados}
        & \textbf{Resultado numérico}\tabularnewline
      \hline
      \endhead
      \hojaResp@cuerpo
    \end{xltabular}
  \endgroup}

\newcommand{\hojaRespuestas}[4][5]{%
  \clearpage
  \phantomsection
  \section*{Hoja de respuestas}
  \addcontentsline{toc}{section}{Hoja de respuestas}
  \noindent\textbf{Nombre:}\,\rule[-0.6ex]{0.44\textwidth}{0.4pt}\hfill
  \textbf{Carné:}\,\rule[-0.6ex]{0.22\textwidth}{0.4pt}\par
  \vspace{3mm}
  \noindent\textit{Traslade aquí sus respuestas. Marque con una «X» la casilla
  de la opción correcta. Sólo se califica lo consignado en esta hoja.}\par
  \vspace{4mm}
  \ifnum\numexpr#2+#3\relax=0\else
    \noindent
    \begin{minipage}[t]{0.48\textwidth}
      \ifnum#2=0\else
        \noindent\textbf{Complete}\par\vspace{3mm}
        \hojaResp@lineas{#2}%
      \fi
    \end{minipage}\hfill
    \begin{minipage}[t]{0.48\textwidth}
      \ifnum#3=0\else
        \noindent\textbf{Selección única}\par\vspace{3mm}
        \hojaResp@opciones{#3}{#1}%
      \fi
    \end{minipage}\par
    \vspace{5mm}
  \fi
  \ifnum#4=0\else
    \noindent\textbf{Respuesta corta}\par
    \vspace{2mm}
    \noindent\textit{Para cada ítem escriba la fórmula que usa, los datos con
    sus unidades y el resultado del cálculo.}\par
    \vspace{3mm}
    \hojaResp@tabla{#4}%
  \fi}

\endinput

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%  headers-UCIMED.sty
%  ---------------------------------------------------------------------------
%  Encabezados y pies de página de las EVALUACIONES de la UCIMED.
%
%  Extracto AUTOSUFICIENTE de SetHeaders.sty: se conservan sólo las ramas
%  institucionales de UCIMED (las de UCR y UFide se eliminaron).
%
%  Requiere, en este orden:
%      format-UCIMED.sty    (accesores \thetitle \theauthor \thedate)
%      colors-UCIMED.sty    (paleta)
%      comands-UCIMED.sty   (\classcode \classname \thecycle \thegroup \ulogo)
%      eval-UCIMED.sty      (\thepartial y el contador totalPoints)
%
%  Dos estilos de página:
%      \thispagestyle{partial}  → portada de la prueba: logo, título del
%                                 parcial, curso, docente, fecha y el puntaje
%                                 total («N puntos ↔ 100 %»).
%      \pagestyle{uplain}       → páginas interiores: «Página n/N» arriba a la
%                                 derecha y «PARCIAL - CÓDIGO - CICLO» al pie.
%      \pagestyle{labguide}     → guías de laboratorio (clase book): encabezado
%                                 de dos líneas con universidad, práctica en
%                                 curso y autor, más el folio centrado al pie.
%                                 Ver el bloque de abajo.
%
%  El puntaje del encabezado es \total{totalPoints}: lo alimentan los
%  \consolidatePoints{...} de cada sección y necesita DOS pasadas de compilación
%  (latexmk las hace solo).
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{headers-UCIMED}[2026/08/13 v1.0 Encabezados de evaluaciones UCIMED]

\RequirePackage{fancyhdr}
\pagestyle{fancy}
\renewcommand{\headrulewidth}{0pt}

%==< Páginas interiores >======================================================
\fancypagestyle{uplain}{%
  \fancyhf{}%
  \fancyhead[R]{%
    Página \thepage/\pageref*{LastPage}\\%
    Versión \laversion
  }%
  \fancyhead[L]{}%
  \fancyfoot[L]{\textsc{\thepartial}\:-\:\classcode\:-\:\thecycle}%
}

%==< Portada de la prueba >====================================================
%  Nota: \date{} vacío rompía el encabezado original («There's no line here to
%  end», porque emitía «\thedate \\»). Aquí la línea de fecha sólo se imprime
%  si \date no está vacío.
\fancypagestyle{partial}{%
  \fancyhf{}%
  \setlength{\headheight}{66pt}%
  \fancyhead[LO]{\usebox{\ulogo}}%
  \fancyhead[C]{%
    \textbf{\Large{\thepartial}}\\%
    \textbf{\classname}\\[0.5em]%
    \textbf{\theauthor}\\[0.5em]%
    \ifdefempty{\@date}{}{\@date}\;-\;\thegroup%\\[0.5em]}%
  }%
  \fancyhead[RO]{%
    \vbox to \ht\ulogo{Página \thepage/\pageref*{LastPage}\\Versión \laversion}%
    
  }%
}

%==< Guía de laboratorio >=====================================================
%  Pensado para la clase `book`. El documento se lee SOLO en digital, así que
%  todas las páginas se maquetan como recto: el encabezado NO se espeja por
%  paridad y conviene declarar la clase con `oneside`.
%
%      cada página   UNIVERSIDAD            │            Lic. Fulano de Tal
%                    Práctica 3. Título     │
%                            ── línea de encabezado ──
%                                      …
%                                     21                (folio centrado al pie)
%
%  «Práctica N. Título» sale de \leftmark, que en `book` alimenta \chaptermark;
%  por eso el documento debe declarar \renewcommand{\chaptername}{Práctica}
%  ANTES del primer \chapter. \nouppercase deshace la versalita forzada de la
%  clase. En el frontmatter no hay capítulos y esa línea sale vacía a propósito.
%
%  Requiere \author{...} en el preámbulo: sin él la línea del autor queda en
%  blanco (\theauthor se resuelve en \begin{document}, así que da igual si el
%  \author va antes o después de cargar los paquetes).
%
%  La paginación vive SOLO en el pie, centrada, igual que el estilo `plain` que
%  la clase `book` fuerza en las aperturas de capítulo. Así el folio aparece en
%  todas las páginas con la misma posición, con encabezado o sin él.
\newcommand{\UCL@inst}{\footnotesize\textsc{\theuni}}
\newcommand{\UCL@pract}{\footnotesize\nouppercase{\leftmark}}
\newcommand{\UCL@auth}{\footnotesize\theauthor}
% Dos líneas alineadas entre sí contra el margen izquierdo.
\newcommand{\UCL@stackl}[2]{\begin{tabular}[b]{@{}l@{}}#1\\#2\end{tabular}}

%  \chaptermark propio: la clase imprime «Capítulo 0. Título» en los capítulos
%  del frontmatter (contador en 0). El prefijo sólo tiene sentido cuando el
%  capítulo está numerado, así que se emite únicamente si el contador > 0.
%  Sólo en clases con capítulos: en `article` no existe \chaptermark.
\@ifundefined{chaptermark}{}{%
  \renewcommand{\chaptermark}[1]{%
    \markboth{\ifnum\value{chapter}>0 \@chapapp\ \thechapter. \fi #1}{}%
  }%
}

\fancypagestyle{labguide}{%
  \fancyhf{}%
  \setlength{\headheight}{28pt}%
  \renewcommand{\headrulewidth}{0.4pt}%
  \fancyhead[L]{\UCL@stackl{\UCL@inst}{\UCL@pract}}%
  \fancyhead[R]{\UCL@auth}%
  \fancyfoot[C]{\thepage}%
}

\endinput

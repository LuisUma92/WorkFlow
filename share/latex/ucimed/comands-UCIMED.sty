%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%  3) PERFIL DE CURSO  —  el mecanismo que pidieron los colegas
%     \setclass{<código>}  fija de una sola vez, para TODO el documento:
%        \classcode  \classname  y el perfil institucional (uni, escuela, logo).
%     Cambiar de curso = cambiar SÓLO la línea \setclass del preámbulo.
%        CB-09 -> Física para Ciencias de la Salud   CBI-06 -> Física I
%        CBI-07 -> Física II                          (otro código -> usa el código)
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\newcommand{\classname}{}
\newcommand{\classcode}{}
\newcommand{\setclass}[1]{%
  \renewcommand{\classcode}{#1}%
  \ifthenelse{\equal{#1}{CB-09}}{%
    \renewcommand{\classname}{Física para Ciencias de la Salud}\ucimed
  }{%
  \ifthenelse{\equal{#1}{CB-09-m}}{%
    \renewcommand{\classname}{Física para Ciencias Médicas}\ucimed
    \renewcommand{\classcode}{CB-09}%
  }{%
  \ifthenelse{\equal{#1}{CBI-06}}{%
    \renewcommand{\classname}{Física I}\ucimed
  }{%
  \ifthenelse{\equal{#1}{CBI-07}}{%
    \renewcommand{\classname}{Física II}\ucimed
  }{%
    \renewcommand{\classname}{#1}\ucimed
  }}}}%
}


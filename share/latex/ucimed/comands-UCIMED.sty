%  5) Guías de laboratorio
%
%  Portados desde SetCommands / PartialCommands para que el bundle UCIMED sea
%  autosuficiente. Van con \providecommand: un documento puede cargar además
%  SetCommands o PartialCommands sin que choquen las definiciones.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Celda de tabla con varias líneas. El PRIMER argumento es OPCIONAL y lleva el
% preámbulo de columna:  \minitab[c]{\(x\)\\(\unit{mm})}
\providecommand{\minitab}[2][]{\begin{tabular}{#1}#2\end{tabular}}

% Los equipos Vernier (LabQuest 2, Graphical Analysis) vienen en inglés de
% fábrica. Todo rótulo de la interfaz se escribe en los dos idiomas para que el
% estudiantado no se pierda por el idioma del menú.
% #1 = rótulo en inglés (de fábrica)   #2 = rótulo en español
\providecommand{\labq}[2]{\texttt{`#1(#2)'}}

% Temas cubiertos por el documento (lo consume el encabezado).
\providecommand{\topics}{}
\providecommand{\settopics}[1]{\renewcommand{\topics}{#1}}

